{
	"name": "remnawave-traffic-guard",
	"version": "1.0.0",
	"description": "Предупреждает пользователей Remnawave о превышении трафика за скользящее окно и отключает после последнего предупреждения",
	"type": "module",
	"main": "dist/index.js",
	"private": true,
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "tsc --watch & node --watch dist/index.js",
		"unblock": "node dist/tools/unblockUser.js",
		"preview": "node dist/tools/previewCards.js"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"dependencies": {
		"@resvg/resvg-js": "^2.6.2"
	},
	"devDependencies": {
		"@types/node": "^20.14.0",
		"typescript": "^5.5.0"
	}
}
