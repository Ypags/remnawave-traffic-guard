# === Remnawave ===
REMNAWAVE_URL=https://panel.example.com
# Создаётся в панели: Settings → API Tokens → Create (НЕ Admin JWT). См. README.
REMNAWAVE_API_TOKEN=

# Если панель закрыта Cloudflare Zero Trust Access — Service Token:
CF_CLIENT_ID=
CF_CLIENT_SECRET=

# Таймаут одного HTTP-запроса к панели, мс
REQUEST_TIMEOUT_MS=15000

# === Правило отключения ===
# Лимит трафика за окно, в гигабайтах
TRAFFIC_LIMIT_GB=50
# Размер скользящего окна, в минутах
WINDOW_MINUTES=60
# Как часто опрашивать панель, в секундах
POLL_INTERVAL_SECONDS=300
# Сколько пользователей запрашивать за одну страницу (max 1000 у Remnawave)
PAGE_SIZE=1000

# === Предупреждения ===
# Сколько предупреждений до блокировки: следующее превышение — отключение
WARNINGS_BEFORE_BLOCK=3
# Через сколько дней после первого предупреждения счётчик обнуляется
STRIKE_RESET_DAYS=30
# Кнопка «Написать в поддержку» в сообщении о блокировке
SUPPORT_URL=https://t.me/GraniVPNSupport

# === Предохранитель ===
# Если кандидатов на отключение за один проход больше ЛЮБОГО из порогов —
# никого не трогаем и шлём алерт в Telegram
CIRCUIT_BREAKER_MAX_USERS=5
CIRCUIT_BREAKER_MAX_PERCENT=10

# === Telegram ===
# Токен ОСНОВНОГО бота: им карточки уходят пользователям, им же отчёт админу.
# Без него пользователи предупреждений не получат (но блокировка сработает).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Хранение состояния ===
STATE_FILE_PATH=./data/state.json
ACTIONS_LOG_PATH=./data/actions.jsonl
